<Project>
  <!-- QuestPDF copies its Lato font files into a LatoFont folder beside every program that uses it. Lineage Roots
       builds the font into the program instead (src/Lineage.App/Reports/PdfFonts.cs), so leave the folder out
       everywhere — including the test projects, so the tests prove the built-in font works. -->
  <Target Name="LeaveOutQuestPdfFontFolder" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.Link)').StartsWith('LatoFont'))" />
    </ItemGroup>
  </Target>

  <!-- ONNX Runtime (the face detector) brings .lib import libraries, which only C++ programs linking to it need;
       leave them out of a published build so the program stays a single file. -->
  <Target Name="LeaveOutImportLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>
</Project>
