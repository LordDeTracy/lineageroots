<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        x:Class="Lineage.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="outline" Content="Cancel" IsCancel="True" MinWidth="96" Click="OnCancel" HorizontalContentAlignment="Center" />
        <Button Classes="primary" IsDefault="True" MinWidth="96" Click="OnSave" HorizontalContentAlignment="Center">
          <TextBlock Text="Save" Foreground="{DynamicResource OnAccent}" />
        </Button>
      </StackPanel>
    </Border>
    <StackPanel Margin="28,24" Spacing="20">
      <TextBlock Classes="title" FontSize="20" Text="Settings" />

      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="KEEPING YOUR WORK SAFE" />
        <Grid ColumnDefinitions="*,14,*">
          <StackPanel>
            <TextBlock Classes="label" Text="Recovery copy" />
            <ComboBox ItemsSource="{Binding AutoSaveOptions}" SelectedIndex="{Binding AutoSaveIndex}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Recovery copy" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Earlier versions" />
            <ComboBox ItemsSource="{Binding BackupOptions}" SelectedIndex="{Binding BackupIndex}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Earlier versions to keep" />
          </StackPanel>
        </Grid>
        <TextBlock Classes="faint small" TextWrapping="Wrap" LineHeight="18"
                   Text="While you have unsaved changes, a recovery copy is written in the background (never over your file) and offered back if Lineage Roots closes unexpectedly. Each time you save, the previous version of the file is kept in the backups folder:" />
        <SelectableTextBlock Classes="small" Text="{Binding BackupFolder}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="APPEARANCE" />
        <ListBox Classes="segmented" ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex}"
                 HorizontalAlignment="Left" AutomationProperties.Name="Theme">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="MAPS" />
        <CheckBox IsChecked="{Binding OnlineMaps}" Content="Show street maps from OpenStreetMap" />
        <TextBlock Classes="faint small" TextWrapping="Wrap" LineHeight="18"
                   Text="Map pictures are downloaded for the area you're looking at — no names or other family details are sent. Turned off, maps show a plain grid with your pins." />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
