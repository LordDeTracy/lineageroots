<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        xmlns:c="using:Lineage.App.Controls"
        x:Class="Lineage.App.Views.CleanupWindow"
        x:DataType="vm:CleanupViewModel"
        Title="Clean up the tree" Width="900" Height="720" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Classes="outline" Click="OnCancel" IsCancel="True" MinWidth="96" HorizontalContentAlignment="Center" Content="Cancel" />
          <Button Classes="primary" Click="OnApply" IsDefault="True" MinWidth="96" IsEnabled="{Binding HasChosen}"
                  HorizontalContentAlignment="Center">
            <TextBlock Text="Clean up" Foreground="{DynamicResource OnAccent}" />
          </Button>
        </StackPanel>
        <TextBlock Classes="muted small" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Margin="28,24,28,8" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Classes="iconTile"><c:LineIcon Data="{StaticResource IconChecklist}" /></Border>
        <TextBlock Classes="title" FontSize="20" Text="Clean up the tree" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Each change is shown before it's made. Untick anything you want to keep as it is." />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="Dates like 03/04/1850 mean" VerticalAlignment="Center" />
        <RadioButton GroupName="order" IsChecked="{Binding DayFirst}" Content="day/month (3 April)" />
        <RadioButton GroupName="order" IsChecked="{Binding MonthFirst}" Content="month/day (4 March)" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer>
      <StackPanel Margin="28,8,28,24" Spacing="22">
        <TextBlock Classes="muted" Text="{Binding Summary}" IsVisible="{Binding IsClean}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CleanupGroup">
              <StackPanel Spacing="8" IsVisible="{Binding HasRows}" Margin="0,0,0,22">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                    <Button Classes="ghost" Content="Tick all" Command="{Binding ChooseAllCommand}" />
                    <Button Classes="ghost" Content="Tick none" Command="{Binding ChooseNoneCommand}" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Classes="section" Text="{Binding Heading}" />
                    <TextBlock Classes="muted small" Text="{Binding Explanation}" TextWrapping="Wrap" />
                  </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanupRow">
                      <Border Classes="card" Padding="14,10" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="Auto,*">
                          <CheckBox IsChecked="{Binding IsChosen}" VerticalAlignment="Top" Margin="0,0,10,0"
                                    AutomationProperties.Name="{Binding Before}" />
                          <StackPanel Grid.Column="1" Spacing="3">
                            <WrapPanel>
                              <TextBlock Text="{Binding Before}" Classes="muted" TextDecorations="Strikethrough" Margin="0,0,8,0" />
                              <TextBlock Text="→" Classes="faint" Margin="0,0,8,0" />
                              <TextBlock Text="{Binding After}" FontWeight="SemiBold" />
                            </WrapPanel>
                            <TextBlock Classes="small faint" Text="{Binding Details}" TextWrapping="Wrap" />
                            <TextBlock Classes="small" Text="{Binding Note}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarnInk}" IsVisible="{Binding IsUnsure}" />
                            <TextBlock Classes="small muted" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding !IsUnsure}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
