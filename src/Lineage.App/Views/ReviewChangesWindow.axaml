<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        xmlns:c="using:Lineage.App.Controls"
        x:Class="Lineage.App.Views.ReviewChangesWindow"
        x:DataType="vm:ReviewChangesViewModel"
        Title="{Binding Title}" Width="900" Height="760" MinWidth="560" MinHeight="420" CanResize="True"
        WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">
  <Window.Styles>
    <Style Selector="Border.conflict"><Setter Property="Background" Value="{DynamicResource DangerBg}" /></Style>
    <Style Selector="Border.conflict TextBlock"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>
    <Style Selector="TextBlock.struck">
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Classes="ghost" Command="{Binding AcceptAllCommand}" Content="Tick all" Margin="-10,0,0,0" />
        <Button Grid.Column="1" Classes="ghost" Command="{Binding RefuseAllCommand}" Content="Untick all" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
          <Button Classes="outline" Content="Cancel" IsCancel="True" MinWidth="96" Click="OnCancel" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Close without taking anything (you can review again later)" />
          <Button Classes="primary" IsDefault="True" MinWidth="140" Click="OnApply" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Take the ticked changes into your tree; unticked ones won't be offered again unless they change">
            <TextBlock Text="{Binding ApplyText}" Foreground="{DynamicResource OnAccent}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="28,24,28,24" Spacing="14">
        <TextBlock Classes="title" FontSize="20" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChangeItem">
              <Border Classes="card" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*">
                  <CheckBox IsChecked="{Binding IsAccepted}" VerticalAlignment="Top" Margin="0,2,10,0"
                            AutomationProperties.Name="{Binding What, StringFormat='Take: {0}'}" />
                  <StackPanel Grid.Column="1" Spacing="6">
                    <WrapPanel>
                      <TextBlock Text="{Binding Who}" FontWeight="SemiBold" Margin="0,0,10,0" />
                      <TextBlock Classes="muted" Text="{Binding What}" Margin="0,0,10,0" />
                      <Border Classes="chip" Padding="7,1" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="{Binding KindLabel}" FontSize="11" />
                      </Border>
                      <Border Classes="chip conflict" Padding="7,1" VerticalAlignment="Center" IsVisible="{Binding IsConflict}"
                              ToolTip.Tip="You changed this too since sending the copy; taking theirs replaces your version.">
                        <TextBlock Text="You changed this too" FontSize="11" />
                      </Border>
                    </WrapPanel>
                    <Grid ColumnDefinitions="*,16,*">
                      <StackPanel Spacing="2" IsVisible="{Binding HasYours}">
                        <TextBlock Classes="faint small" Text="{Binding YoursLabel}" />
                        <TextBlock Text="{Binding Yours}" TextWrapping="Wrap" Classes.struck="{Binding IsRemoval}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2" IsVisible="{Binding HasTheirs}">
                        <TextBlock Classes="faint small" Text="Theirs" />
                        <TextBlock Text="{Binding Theirs}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
