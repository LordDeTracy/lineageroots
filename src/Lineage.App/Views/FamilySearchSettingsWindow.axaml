<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        xmlns:c="using:Lineage.App.Controls"
        x:Class="Lineage.App.Views.FamilySearchSettingsWindow"
        x:DataType="vm:FamilySearchSettingsViewModel"
        Title="FamilySearch settings" Width="580" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="outline" Content="Cancel" IsCancel="True" MinWidth="96" Click="OnCancel" HorizontalContentAlignment="Center" />
        <Button Classes="primary" IsDefault="True" MinWidth="96" Click="OnSave" HorizontalContentAlignment="Center">
          <TextBlock Text="Save" Foreground="{DynamicResource OnAccent}" />
        </Button>
      </StackPanel>
    </Border>
    <StackPanel Margin="28,24" Spacing="18">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Classes="iconTile"><c:LineIcon Data="{StaticResource IconCloud}" /></Border>
        <TextBlock Classes="title" FontSize="20" Text="Connect to FamilySearch" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="21"
                 Text="FamilySearch gives every program its own app key through its free developer program. Enter yours here once. You'll sign in on FamilySearch's own website — Lineage Roots never sees your password, and it only reads from FamilySearch; it never changes anything there." />
      <Button Classes="ghost accentText" Command="{Binding OpenDeveloperSiteCommand}" Margin="-10,-8,0,0" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:LineIcon Data="{StaticResource IconExternal}" Width="15" Height="15" Foreground="{DynamicResource Accent}" />
          <TextBlock Text="FamilySearch developer program" Foreground="{DynamicResource Accent}" />
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Classes="label" Text="App key" />
        <TextBox Name="KeyBox" Text="{Binding AppKey}" Watermark="e.g. a02f100000ABCDEF" AutomationProperties.Name="FamilySearch app key" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="label" Text="Environment" />
        <ListBox Classes="segmented" SelectedIndex="{Binding EnvironmentIndex}" AutomationProperties.Name="FamilySearch environment">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBoxItem Content="Production" />
          <ListBoxItem Content="Integration (testing)" />
        </ListBox>
        <TextBlock Classes="faint small" Margin="2,6,0,0" TextWrapping="Wrap"
                   Text="New app keys start in Integration, FamilySearch's test copy of the tree, until FamilySearch approves them." />
      </StackPanel>
      <Grid ColumnDefinitions="110,14,*">
        <StackPanel>
          <TextBlock Classes="label" Text="Sign-in port" />
          <TextBox Text="{Binding Port}" AutomationProperties.Name="Sign-in port" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Classes="label" Text="Redirect URI to register with FamilySearch" />
          <SelectableTextBlock Text="{Binding RedirectUri}" Margin="2,9,0,0" FontFamily="Consolas, Menlo, monospace" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
