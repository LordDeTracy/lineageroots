<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        x:Class="Lineage.App.Views.TutorialWindow"
        x:DataType="vm:TutorialViewModel"
        Title="Getting started" Width="720" Height="560" MinWidth="520" MinHeight="420" CanResize="True"
        WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <CheckBox IsChecked="{Binding DontShowAgain}" Content="Don't show this again when the program starts" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="faint small" Text="{Binding Position}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Classes="outline" Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding !IsFirst}" MinWidth="80"
                  HorizontalContentAlignment="Center" />
          <Button Classes="primary" Command="{Binding NextCommand}" MinWidth="96" HorizontalContentAlignment="Center" IsDefault="True">
            <TextBlock Text="{Binding NextText}" Foreground="{DynamicResource OnAccent}" />
          </Button>
          <Button Classes="ghost" Content="Close" Click="OnClose" IsCancel="True" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="32,28,32,24" Spacing="14">
        <TextBlock Classes="display" FontSize="26" Text="{Binding Page.Title}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Page.Body}" TextWrapping="Wrap" FontSize="15" LineHeight="23" IsVisible="{Binding !IsShortcuts}" />
        <ItemsControl ItemsSource="{x:Static vm:TutorialViewModel.Shortcuts}" IsVisible="{Binding IsShortcuts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:Shortcut">
              <Grid ColumnDefinitions="190,*" Margin="0,3">
                <Border Classes="chip" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding What}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
