<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        xmlns:c="using:Lineage.App.Controls"
        x:Class="Lineage.App.Views.SourceEditorWindow"
        x:DataType="vm:SourceEditorViewModel"
        Title="{Binding Title}" Width="600" Height="760" MinHeight="420" CanResize="True"
        WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="ghost danger" IsVisible="{Binding CanDelete}" Click="OnDelete" Margin="-10,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <c:LineIcon Data="{StaticResource IconTrash}" Width="16" Height="16" Foreground="{DynamicResource Danger}" />
            <TextBlock Text="Delete source" Foreground="{DynamicResource Danger}" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="outline" Content="Cancel" IsCancel="True" MinWidth="96" Click="OnCancel"
                  HorizontalContentAlignment="Center" />
          <Button Classes="primary" IsDefault="True" MinWidth="96" Click="OnSave" HorizontalContentAlignment="Center">
            <TextBlock Text="Save" Foreground="{DynamicResource OnAccent}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="28,24,28,24" Spacing="18">
        <TextBlock Classes="title" FontSize="20" Text="{Binding Title}" />

        <StackPanel Spacing="10">
          <StackPanel Spacing="6" IsVisible="{Binding ShowLinkTools}">
            <TextBlock Classes="label" Text="Make the citation from a web link" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox Text="{Binding Link}" Watermark="Paste a link to a record, e.g. on FamilySearch or Find a Grave"
                       AutomationProperties.Name="Web link" />
              <Button Grid.Column="2" Classes="outline" Content="Fill in" Command="{Binding FillFromLinkCommand}" />
            </Grid>
            <TextBlock Classes="muted small" Text="{Binding LinkMessage}" TextWrapping="Wrap" IsVisible="{Binding HasLinkMessage}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="Citation template" />
            <ComboBox ItemsSource="{x:Static vm:SourceEditorViewModel.TemplateOptions}" SelectedItem="{Binding TemplateOption}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Citation template"
                      ToolTip.Tip="Fill in a form for this kind of source, and notes and bibliographies are written in the Evidence Explained style" />
          </StackPanel>
          <Border IsVisible="{Binding HasTemplate}" Classes="card" Padding="16,14" CornerRadius="12"
                  Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel Spacing="10">
              <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TemplateFieldRow">
                    <StackPanel Margin="0,0,12,10">
                      <TextBlock Classes="label" Text="{Binding Label}" />
                      <TextBox Text="{Binding Value}" Watermark="{Binding Example}" AutomationProperties.Name="{Binding Label}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="section" Text="HOW IT WILL BE CITED" />
              <TextBlock Classes="faint small" Text="First note (the page or entry comes from each citation)" />
              <SelectableTextBlock Text="{Binding PreviewFull}" TextWrapping="Wrap" />
              <TextBlock Classes="faint small" Text="Later notes" />
              <SelectableTextBlock Text="{Binding PreviewShort}" TextWrapping="Wrap" />
              <TextBlock Classes="faint small" Text="Bibliography" />
              <SelectableTextBlock Text="{Binding PreviewBibliography}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="label" Text="Title" />
          <TextBox Name="TitleBox" Text="{Binding SourceTitle}" Watermark="e.g. 1880 United States Census"
                   AutomationProperties.Name="Source title" />
        </StackPanel>
        <Grid ColumnDefinitions="*,14,*">
          <StackPanel>
            <TextBlock Classes="label" Text="Author or creator" />
            <TextBox Text="{Binding Author}" Watermark="Person or agency" AutomationProperties.Name="Author" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Kind of source" />
            <TextBox Text="{Binding Type}" Watermark="Census, parish register, book…" AutomationProperties.Name="Kind of source" />
          </StackPanel>
        </Grid>
        <StackPanel>
          <TextBlock Classes="label" Text="Is it the original record?" />
          <ComboBox ItemsSource="{x:Static vm:SourceEditorViewModel.Kinds}" SelectedIndex="{Binding KindIndex}" MinWidth="320"
                    AutomationProperties.Name="Original, copy or compiled"
                    ToolTip.Tip="Original records carry the most weight; copies, transcripts and indexes can introduce mistakes; compiled works are someone's conclusions." />
        </StackPanel>
        <Grid ColumnDefinitions="2*,14,*">
          <StackPanel>
            <TextBlock Classes="label" Text="Publication details" />
            <TextBox Text="{Binding Publication}" Watermark="Publisher, place, year, website" AutomationProperties.Name="Publication details" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Call number" />
            <TextBox Text="{Binding CallNumber}" Watermark="Film, shelf or item no." AutomationProperties.Name="Call number" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="WHERE IT IS KEPT" Margin="2,6,0,0" />
          <ComboBox ItemsSource="{Binding Repositories}" SelectedItem="{Binding Repository}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Repository" />
          <StackPanel Spacing="12" IsVisible="{Binding HasRepository}">
            <Grid ColumnDefinitions="*,14,*">
              <StackPanel>
                <TextBlock Classes="label" Text="Archive or library" />
                <TextBox Text="{Binding RepositoryName}" Watermark="e.g. West Yorkshire Archive Service"
                         AutomationProperties.Name="Repository name" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Classes="label" Text="Phone or website" />
                <TextBox Text="{Binding RepositoryPhone}" AutomationProperties.Name="Repository phone or website" />
              </StackPanel>
            </Grid>
            <StackPanel>
              <TextBlock Classes="label" Text="Address" />
              <TextBox Text="{Binding RepositoryAddress}" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                       VerticalContentAlignment="Top" AutomationProperties.Name="Repository address" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="2,6,0,10">
            <TextBlock Classes="section" Text="TRANSCRIPT OR EXTRACT" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost accentText" Content="Read from a scan…" Command="{Binding ReadScanCommand}"
                    IsVisible="{Binding CanReadScan}" ToolTip.Tip="Reads clear print from a picture of the record; it stays on this computer" />
          </Grid>
          <TextBlock Classes="muted small" Text="{Binding ScanMessage}" TextWrapping="Wrap" Margin="2,0,0,8" IsVisible="{Binding HasScanMessage}" />
          <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                   VerticalContentAlignment="Top" Watermark="Copy the exact wording of the record here"
                   AutomationProperties.Name="Transcript" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="section" Text="NOTES" Margin="2,6,0,10" />
          <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                   VerticalContentAlignment="Top" AutomationProperties.Name="Notes" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
