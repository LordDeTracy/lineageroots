<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        xmlns:c="using:Lineage.App.Controls"
        x:Class="Lineage.App.Views.FamilySearchSearchWindow"
        x:DataType="vm:FamilySearchSearchViewModel"
        Title="{Binding Title}" Width="760" Height="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="ghost" Command="{Binding OpenSelectedCommand}" IsEnabled="{Binding HasSelection}" Margin="-10,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <c:LineIcon Data="{StaticResource IconExternal}" Width="16" Height="16" />
            <TextBlock Text="View on FamilySearch.org" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="outline" Content="Cancel" IsCancel="True" MinWidth="96" Click="OnCancel" HorizontalContentAlignment="Center" />
          <Button Classes="primary" IsEnabled="{Binding HasSelection}" Click="OnLink">
            <TextBlock Text="Link to this person" Foreground="{DynamicResource OnAccent}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <DockPanel Margin="28,24,28,16">
      <StackPanel DockPanel.Dock="Top" Spacing="14">
        <TextBlock Classes="title" FontSize="20" Text="{Binding Title}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,10,*,10,90,10,*,10,Auto">
          <TextBox Text="{Binding Given}" Watermark="Given names" AutomationProperties.Name="Given names" />
          <TextBox Grid.Column="2" Text="{Binding Surname}" Watermark="Surname" AutomationProperties.Name="Surname" />
          <TextBox Grid.Column="4" Text="{Binding BirthYear}" Watermark="Born" AutomationProperties.Name="Birth year" />
          <TextBox Grid.Column="6" Text="{Binding BirthPlace}" Watermark="Birthplace" AutomationProperties.Name="Birthplace" />
          <Button Grid.Column="8" Classes="outline" Command="{Binding SearchCommand}" IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:LineIcon Data="{StaticResource IconSearch}" Width="16" Height="16" />
              <TextBlock Text="Search" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Classes="muted small" Text="{Binding Message}" TextWrapping="Wrap" />
      </StackPanel>
      <ListBox Classes="people" Margin="0,10,0,0" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
               AutomationProperties.Name="Search results">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:FsResultRow">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="Medium" />
              <TextBlock Classes="muted small" Text="{Binding Detail}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</Window>
