<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        xmlns:c="using:Lineage.App.Controls"
        x:Class="Lineage.App.Views.ExportOptionsWindow"
        x:DataType="vm:ExportOptionsViewModel"
        Title="{Binding Title}" Width="580" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="outline" Content="Cancel" IsCancel="True" MinWidth="96" Click="OnCancel" HorizontalContentAlignment="Center" />
        <Button Classes="primary" IsDefault="True" MinWidth="96" Click="OnContinue" HorizontalContentAlignment="Center">
          <TextBlock Text="{Binding Action}" Foreground="{DynamicResource OnAccent}" />
        </Button>
      </StackPanel>
    </Border>
    <StackPanel Margin="28,24" Spacing="18">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Classes="iconTile"><c:LineIcon Data="{StaticResource IconUsers}" /></Border>
        <TextBlock Classes="title" FontSize="20" Text="{Binding Title}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="LIVING PEOPLE" />
        <TextBlock Classes="muted" Text="{Binding LivingText}" TextWrapping="Wrap" />
        <ListBox Classes="choices" ItemsSource="{Binding LivingOptions}" SelectedIndex="{Binding LivingIndex}"
                 AutomationProperties.Name="Living people" />
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="ALSO LEAVE OUT" />
        <CheckBox IsChecked="{Binding ExcludePrivateEvents}" Content="Events marked private" />
        <CheckBox IsChecked="{Binding ExcludeNotes}" Content="Notes" />
        <CheckBox IsChecked="{Binding ExcludeMedia}" Content="Photos and other media" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
