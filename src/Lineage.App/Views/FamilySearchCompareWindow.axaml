<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        x:Class="Lineage.App.Views.FamilySearchCompareWindow"
        x:DataType="vm:FamilySearchCompareViewModel"
        Title="{Binding Title}" Width="820" Height="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="outline" Content="Cancel" IsCancel="True" MinWidth="96" Click="OnCancel" HorizontalContentAlignment="Center" />
        <Button Classes="primary" IsDefault="True" Click="OnApply">
          <TextBlock Text="Copy ticked into my tree" Foreground="{DynamicResource OnAccent}" />
        </Button>
      </StackPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="28,24" Spacing="14">
        <TextBlock Classes="title" FontSize="20" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
        <Border Classes="card" Padding="0">
          <StackPanel>
            <Grid ColumnDefinitions="40,150,*,*" Margin="16,12">
              <TextBlock Grid.Column="2" Classes="section" Text="YOUR TREE" />
              <TextBlock Grid.Column="3" Classes="section" Text="FAMILYSEARCH" />
            </Grid>
            <Border Height="1" Background="{DynamicResource Line}" />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FieldDiffRow">
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,8">
                    <Grid ColumnDefinitions="40,150,*,*">
                      <CheckBox IsChecked="{Binding Use}" IsEnabled="{Binding CanUse}" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Diff.Label, StringFormat='Use FamilySearch value for {0}'}" />
                      <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding Diff.Label}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Diff.Local}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <TextBlock Grid.Column="3" Text="{Binding Diff.Remote}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
