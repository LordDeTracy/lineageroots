<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        x:Class="Lineage.App.Views.ReportPreviewWindow"
        x:DataType="vm:ReportPreviewViewModel"
        Title="Preview" Width="900" Height="860" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Backdrop}" Foreground="{DynamicResource Ink}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted small" Text="{Binding PageCount}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="outline" Content="Close" IsCancel="True" MinWidth="96" Click="OnClose" HorizontalContentAlignment="Center" />
          <Button Classes="primary" IsDefault="True" Click="OnSave">
            <TextBlock Text="Save or print…" Foreground="{DynamicResource OnAccent}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Pages}" Margin="32,24">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="White" CornerRadius="6" Margin="0,0,0,24" HorizontalAlignment="Center"
                    BoxShadow="0 4 18 -6 #59000000" ClipToBounds="True" MaxWidth="760">
              <Image Source="{Binding}" Stretch="Uniform" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
