<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lineage.App.ViewModels"
        xmlns:c="using:Lineage.App.Controls"
        x:Class="Lineage.App.Views.SideBySideWindow"
        x:DataType="vm:SideBySideViewModel"
        Title="Side by side" Width="1100" Height="760" MinWidth="760" WindowStartupLocation="CenterOwner" Classes="editor"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">
  <Window.Resources>
    <DataTemplate x:Key="Column" x:DataType="vm:SideColumn">
      <Border Classes="card" Padding="22,18">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding Years}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost accentText" VerticalAlignment="Top" Content="Open"
                    Command="{Binding $parent[Window].((vm:SideBySideViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                    ToolTip.Tip="Close this and show them in the main window" />
          </Grid>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SideLine">
                  <Panel>
                    <TextBlock Classes="section" Text="{Binding Label}" IsVisible="{Binding Heading}" Margin="0,14,0,6" />
                    <Grid ColumnDefinitions="130,*" IsVisible="{Binding !Heading}" Margin="0,3">
                      <TextBlock Classes="muted small" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,1,10,0" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                    </Grid>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <DockPanel Margin="24,20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,14">
      <TextBlock Classes="title" FontSize="20" Text="Side by side" VerticalAlignment="Center" Margin="0,0,20,0" />
      <AutoCompleteBox Grid.Column="1" Text="{Binding RightName}" ItemsSource="{Binding PeopleNames}" FilterMode="Contains"
                       Watermark="Who to show on the right — type a name" AutomationProperties.Name="Person on the right" />
      <Button Grid.Column="2" Classes="outline" Content="Swap" Command="{Binding SwapCommand}" Margin="10,0,0,0" />
      <Button Grid.Column="3" Classes="primary" Click="OnClose" Margin="10,0,0,0" IsCancel="True">
        <TextBlock Text="Close" Foreground="{DynamicResource OnAccent}" />
      </Button>
    </Grid>
    <Grid ColumnDefinitions="*,16,*">
      <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource Column}" />
      <ContentControl Grid.Column="2" Content="{Binding Right}" ContentTemplate="{StaticResource Column}" />
    </Grid>
  </DockPanel>
</Window>
