<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The Windows 7 SP1 / 8.1 build: publish with -p:Legacy=true. .NET 6 is the last .NET that runs there. -->
    <TargetFramework Condition="'$(Legacy)' == 'true'">net6.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LineageRoots</AssemblyName>
    <Product>Lineage Roots</Product>
    <AssemblyTitle>Lineage Roots</AssemblyTitle>
    <RootNamespace>Lineage.App</RootNamespace>
    <Version>0.4.4</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The .NET 7+ attributes the Windows 7 build needs (compiles to nothing in the normal build). -->
    <Compile Include="..\Lineage.Core\LegacyCompat.cs" Link="LegacyCompat.cs" />
    <InternalsVisibleTo Include="Lineage.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lineage.Core\Lineage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- The logo, icon and welcome background (docs/brand has the full-size originals). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- QuestPDF's default font (Lato) is built into the program instead of a LatoFont folder beside it;
       Reports/PdfFonts.cs registers it, and Directory.Build.targets stops the folder being copied.
       The font's licence ships as a text file with releases. -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgQuestPDF)\LatoFont\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
